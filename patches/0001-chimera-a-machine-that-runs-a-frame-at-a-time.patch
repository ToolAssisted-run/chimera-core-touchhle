diff --git a/src/chimera/mod.rs b/src/chimera/mod.rs
new file mode 100644
--- /dev/null
+++ b/src/chimera/mod.rs
@@ -0,0 +1,149 @@
+/*
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/.
+ */
+//! What the Chimera core drives: touchHLE as a machine that runs one frame at
+//! a time.
+//!
+//! touchHLE's own main loop ([crate::Environment::run]) never returns until
+//! the app exits. Here it runs inside a coroutine of its own, and yields back
+//! to the core at the end of every frame. A frame is 1/60 s of MACHINE time
+//! ([crate::time]): it ends between two threads' turns once the clock has
+//! passed its end ([frame_boundary]), or, when every thread is asleep, when
+//! the clock is moved there instead of past it ([idle_until]). Nothing about
+//! where a frame ends depends on the host, so a frame's input always reaches
+//! the app at the same point of its execution.
+//!
+//! Everything here lives in the machine's own memory, the coroutine's stack
+//! included, which is what makes a sandbox snapshot a savestate.
+
+use crate::environment::Environment;
+use crate::time::Instant;
+use corosensei::stack::DefaultStack;
+use corosensei::{Coroutine, CoroutineResult, Yielder};
+
+pub mod resources;
+
+pub use crate::window::{set_tilt, set_touch, video, MAX_FINGERS};
+
+/// Frames per second: the frame clock is 60/1.
+pub const FRAMES_PER_SECOND: u64 = 60;
+
+/// The stack touchHLE's main loop runs on (upstream runs it on the host's
+/// main thread).
+const MACHINE_STACK_SIZE: usize = 16 << 20;
+
+type Machine = Coroutine<(), (), Result<(), String>, DefaultStack>;
+
+struct State {
+    machine: Option<Machine>,
+    /// The machine coroutine's yielder, valid while it runs.
+    yielder: *const Yielder<(), ()>,
+    /// Frames completed.
+    frame: u64,
+    /// Set when touchHLE's main returned: the app exited, or failed to start.
+    exited: Option<Result<(), String>>,
+}
+static mut STATE: State = State {
+    machine: None,
+    yielder: std::ptr::null(),
+    frame: 0,
+    exited: None,
+};
+// The machine is one thread.
+#[allow(static_mut_refs)]
+fn state() -> &'static mut State {
+    unsafe { &mut STATE }
+}
+
+/// When frame `frame` ends, in nanoseconds of machine time: the exact
+/// rational 1/60 s boundary, rounded down.
+fn frame_end_ns(frame: u64) -> u64 {
+    ((frame as u128 + 1) * 1_000_000_000 / FRAMES_PER_SECOND as u128) as u64
+}
+
+/// Whether `path` is an app bundle touchHLE can open, and why not: the same
+/// two steps upstream's `main` begins with, done before anything runs so a
+/// bad file is refused when the core loads rather than on its first frame.
+pub fn check_bundle(path: &str) -> Result<(), String> {
+    let data = crate::fs::BundleData::open_any(std::path::Path::new(path))
+        .map_err(|e| format!("Could not open app bundle: {e}"))?;
+    crate::bundle::Bundle::new_bundle_and_fs_from_host_path(data, /* read_only_mode: */ true)
+        .map(|_| ())
+        .map_err(|e| format!("Application bundle error: {e}"))
+}
+
+/// Make the machine: touchHLE's command line, as upstream's `main` takes it
+/// (argv[0] first). Nothing runs until the first [run_frame].
+pub fn boot(args: Vec<String>) {
+    let s = state();
+    assert!(s.machine.is_none(), "the machine is already made");
+    let stack = DefaultStack::new(MACHINE_STACK_SIZE).expect("no stack for the machine");
+    s.machine = Some(Coroutine::with_stack(
+        stack,
+        move |yielder: &Yielder<(), ()>, ()| {
+            state().yielder = yielder;
+            crate::main(args.into_iter())
+        },
+    ));
+}
+
+/// Run one frame. Returns `None` while the app runs, and what touchHLE's main
+/// returned once it has exited (then and on every later call).
+pub fn run_frame() -> Option<Result<(), String>> {
+    let s = state();
+    if let Some(ref exited) = s.exited {
+        return Some(exited.clone());
+    }
+    let machine = s.machine.as_mut().expect("the machine is not made");
+    match machine.resume(()) {
+        CoroutineResult::Yield(()) => None,
+        CoroutineResult::Return(result) => {
+            // An app that exits mid-frame still ends that frame.
+            s.frame += 1;
+            s.exited = Some(result.clone());
+            Some(result)
+        }
+    }
+}
+
+/// Frames completed.
+pub fn frame_count() -> u64 {
+    state().frame
+}
+
+/// Called between threads' turns: end the frame if machine time has passed
+/// its end.
+pub(crate) fn frame_boundary(env: &mut Environment) {
+    if crate::time::now_ns() >= frame_end_ns(state().frame) {
+        end_frame(env);
+    }
+}
+
+/// Called when every thread is blocked and the earliest sleeper wakes at
+/// `until`: move machine time there, or to the end of the frame if that comes
+/// first, and end the frame.
+pub(crate) fn idle_until(env: &mut Environment, until: Instant) {
+    let end = frame_end_ns(state().frame);
+    if until.as_nanos() >= end {
+        crate::time::advance_to(end);
+        end_frame(env);
+    } else {
+        crate::time::advance_to(until.as_nanos());
+    }
+}
+
+fn end_frame(env: &mut Environment) {
+    let s = state();
+    s.frame += 1;
+    let yielder = s.yielder;
+    assert!(!yielder.is_null());
+    // Back to the core until the next frame; this frame's picture is already
+    // in the window's buffer.
+    unsafe { (*yielder).suspend(()) };
+    // The next frame's input, before anything else runs.
+    if let Some(window) = env.window.as_mut() {
+        window.poll_for_events(&env.options);
+    }
+}
diff --git a/src/chimera/resources.rs b/src/chimera/resources.rs
new file mode 100644
--- /dev/null
+++ b/src/chimera/resources.rs
@@ -0,0 +1,62 @@
+/*
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/.
+ */
+//! The files touchHLE ships beside itself, carried inside Chimera's build: a
+//! core has no directory of its own to keep them in. Looked up by the path
+//! upstream opens them by ([crate::paths::ResourceFile]).
+//!
+//! touchHLE_dylibs: Free Software iPhone OS libraries the apps link against
+//! (see their README.md and COPYING files); touchHLE_fonts: Liberation and
+//! Noto; touchHLE_default_options.txt: the per-app options touchHLE knows
+//! certain apps need.
+
+macro_rules! resources {
+    ($($path:literal),* $(,)?) => {
+        const RESOURCES: &[(&str, &[u8])] = &[
+            $(($path, include_bytes!(concat!(env!("CARGO_MANIFEST_DIR"), "/", $path)))),*
+        ];
+    };
+}
+
+resources![
+    "touchHLE_default_options.txt",
+    "touchHLE_dylibs/COPYING.libgcc",
+    "touchHLE_dylibs/COPYING.libsqlite3",
+    "touchHLE_dylibs/COPYING.libstdcxx",
+    "touchHLE_dylibs/COPYING.libxml2",
+    "touchHLE_dylibs/COPYING.libz",
+    "touchHLE_dylibs/README.md",
+    "touchHLE_dylibs/libgcc_s.1.dylib",
+    "touchHLE_dylibs/libsqlite3.dylib",
+    "touchHLE_dylibs/libstdc++.6.0.9.dylib",
+    "touchHLE_dylibs/libxml2.2.dylib",
+    "touchHLE_dylibs/libz.1.2.3.dylib",
+    "touchHLE_fonts/LICENSE.liberation",
+    "touchHLE_fonts/LICENSE.noto",
+    "touchHLE_fonts/LiberationMono-Bold.ttf",
+    "touchHLE_fonts/LiberationMono-BoldItalic.ttf",
+    "touchHLE_fonts/LiberationMono-Italic.ttf",
+    "touchHLE_fonts/LiberationMono-Regular.ttf",
+    "touchHLE_fonts/LiberationSans-Bold.ttf",
+    "touchHLE_fonts/LiberationSans-BoldItalic.ttf",
+    "touchHLE_fonts/LiberationSans-Italic.ttf",
+    "touchHLE_fonts/LiberationSans-Regular.ttf",
+    "touchHLE_fonts/LiberationSerif-Bold.ttf",
+    "touchHLE_fonts/LiberationSerif-BoldItalic.ttf",
+    "touchHLE_fonts/LiberationSerif-Italic.ttf",
+    "touchHLE_fonts/LiberationSerif-Regular.ttf",
+    "touchHLE_fonts/NotoSansJP-Bold.otf",
+    "touchHLE_fonts/NotoSansJP-Regular.otf",
+    "touchHLE_fonts/README.md",
+];
+
+/// A resource's bytes, by the path upstream opens it by.
+pub fn get(path: &str) -> Option<&'static [u8]> {
+    let path = path.strip_prefix("./").unwrap_or(path);
+    RESOURCES
+        .iter()
+        .find(|(name, _)| *name == path)
+        .map(|(_, data)| *data)
+}
diff --git a/src/chimera/time.rs b/src/chimera/time.rs
new file mode 100644
--- /dev/null
+++ b/src/chimera/time.rs
@@ -0,0 +1,221 @@
+/*
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/.
+ */
+//! The clocks an app sees, in Chimera's build: virtual ones.
+//!
+//! Everything in touchHLE that asks what time it is - the scheduler's sleeps,
+//! NSTimer, the frame limiter, NSDate, `time()`, `mach_absolute_time()`, the
+//! audio callbacks - goes through this module's [Instant] and [SystemTime],
+//! which keep std's names and the methods touchHLE uses. In the upstream build
+//! `crate::time` is std's own.
+//!
+//! Time is bought with executed instructions ([advance_ticks], called after
+//! every stretch the CPU runs), and when every thread is asleep the scheduler
+//! jumps it to the next deadline ([advance_to]). Nothing here reads a host
+//! clock, so the same inputs give the same machine on any host at any speed.
+//! The wall-clock date the app sees starts at [set_epoch] and moves with the
+//! same clock.
+
+use std::time::Duration;
+
+/// The CPU clock that converts executed instructions into time. dynarmic
+/// counts one tick per instruction, and the first iPhone and the iPhone 3G
+/// both ran their ARM11 at 412 MHz.
+static mut CPU_HZ: u64 = 412_000_000;
+/// Instructions executed since the machine started.
+static mut TICKS: u64 = 0;
+/// Time spent with every thread asleep, in nanoseconds.
+static mut IDLE_NS: u64 = 0;
+/// The wall-clock date when the machine started, since the Unix epoch.
+static mut EPOCH: Duration = Duration::from_secs(946_684_800); // 2000-01-01T00:00:00Z
+
+// The machine is one thread, and these are only ever touched from it.
+
+/// Set the CPU clock (Hz). Only before the machine starts.
+pub fn set_cpu_hz(hz: u64) {
+    assert!(hz > 0);
+    unsafe { CPU_HZ = hz };
+}
+
+/// Set the wall-clock date the machine starts at. Only before it starts.
+pub fn set_epoch(since_unix_epoch: Duration) {
+    unsafe { EPOCH = since_unix_epoch };
+}
+
+/// Instructions executed since the machine started: the finest measure of how
+/// far it got, and the first thing to compare between two runs.
+pub fn ticks() -> u64 {
+    unsafe { TICKS }
+}
+
+/// Nanoseconds of machine time since the machine started.
+pub fn now_ns() -> u64 {
+    unsafe {
+        let ticks_ns = ((TICKS as u128) * 1_000_000_000 / (CPU_HZ as u128)) as u64;
+        IDLE_NS + ticks_ns
+    }
+}
+
+/// Account for instructions the CPU executed.
+pub fn advance_ticks(ticks: u64) {
+    unsafe { TICKS += ticks };
+}
+
+/// Move machine time forward to `ns`, when nothing runs until then. Never
+/// moves it back.
+pub fn advance_to(ns: u64) {
+    let now = now_ns();
+    if ns > now {
+        unsafe { IDLE_NS += ns - now };
+    }
+}
+
+#[derive(Copy, Clone, PartialEq, Eq, PartialOrd, Ord, Hash, Debug)]
+pub struct Instant(u64);
+
+impl Instant {
+    pub fn now() -> Instant {
+        Instant(now_ns())
+    }
+    /// Nanoseconds since the machine started.
+    pub fn as_nanos(self) -> u64 {
+        self.0
+    }
+    pub fn from_nanos(ns: u64) -> Instant {
+        Instant(ns)
+    }
+    pub fn duration_since(&self, earlier: Instant) -> Duration {
+        self.saturating_duration_since(earlier)
+    }
+    pub fn checked_duration_since(&self, earlier: Instant) -> Option<Duration> {
+        self.0.checked_sub(earlier.0).map(Duration::from_nanos)
+    }
+    pub fn saturating_duration_since(&self, earlier: Instant) -> Duration {
+        Duration::from_nanos(self.0.saturating_sub(earlier.0))
+    }
+    pub fn checked_add(&self, d: Duration) -> Option<Instant> {
+        u64::try_from(d.as_nanos())
+            .ok()
+            .and_then(|d| self.0.checked_add(d))
+            .map(Instant)
+    }
+    pub fn checked_sub(&self, d: Duration) -> Option<Instant> {
+        u64::try_from(d.as_nanos())
+            .ok()
+            .and_then(|d| self.0.checked_sub(d))
+            .map(Instant)
+    }
+    #[allow(dead_code)]
+    pub fn elapsed(&self) -> Duration {
+        Instant::now().duration_since(*self)
+    }
+}
+
+impl std::ops::Add<Duration> for Instant {
+    type Output = Instant;
+    fn add(self, d: Duration) -> Instant {
+        self.checked_add(d)
+            .expect("overflow when adding duration to instant")
+    }
+}
+impl std::ops::AddAssign<Duration> for Instant {
+    fn add_assign(&mut self, d: Duration) {
+        *self = *self + d;
+    }
+}
+impl std::ops::Sub<Duration> for Instant {
+    type Output = Instant;
+    fn sub(self, d: Duration) -> Instant {
+        self.checked_sub(d)
+            .expect("overflow when subtracting duration from instant")
+    }
+}
+impl std::ops::SubAssign<Duration> for Instant {
+    fn sub_assign(&mut self, d: Duration) {
+        *self = *self - d;
+    }
+}
+impl std::ops::Sub<Instant> for Instant {
+    type Output = Duration;
+    fn sub(self, other: Instant) -> Duration {
+        self.duration_since(other)
+    }
+}
+
+/// A date: the time since the Unix epoch. Dates before 1970 are not needed by
+/// anything touchHLE does with them.
+#[derive(Copy, Clone, PartialEq, Eq, PartialOrd, Ord, Hash, Debug)]
+pub struct SystemTime(Duration);
+
+pub const UNIX_EPOCH: SystemTime = SystemTime(Duration::ZERO);
+
+#[derive(Clone, Debug)]
+pub struct SystemTimeError(Duration);
+impl SystemTimeError {
+    #[allow(dead_code)]
+    pub fn duration(&self) -> Duration {
+        self.0
+    }
+}
+impl std::fmt::Display for SystemTimeError {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(f, "second time provided was later than self")
+    }
+}
+impl std::error::Error for SystemTimeError {}
+
+impl SystemTime {
+    pub const UNIX_EPOCH: SystemTime = UNIX_EPOCH;
+
+    pub fn now() -> SystemTime {
+        SystemTime(unsafe { EPOCH } + Duration::from_nanos(now_ns()))
+    }
+    pub fn duration_since(&self, earlier: SystemTime) -> Result<Duration, SystemTimeError> {
+        self.0
+            .checked_sub(earlier.0)
+            .ok_or_else(|| SystemTimeError(earlier.0 - self.0))
+    }
+    pub fn checked_add(&self, d: Duration) -> Option<SystemTime> {
+        self.0.checked_add(d).map(SystemTime)
+    }
+    pub fn checked_sub(&self, d: Duration) -> Option<SystemTime> {
+        self.0.checked_sub(d).map(SystemTime)
+    }
+    #[allow(dead_code)]
+    pub fn elapsed(&self) -> Result<Duration, SystemTimeError> {
+        SystemTime::now().duration_since(*self)
+    }
+}
+
+/// A date read from or written to app data (a plist's dates) is just a date:
+/// these convert between the two kinds without reading any clock.
+impl From<SystemTime> for std::time::SystemTime {
+    fn from(t: SystemTime) -> std::time::SystemTime {
+        std::time::UNIX_EPOCH + t.0
+    }
+}
+impl From<std::time::SystemTime> for SystemTime {
+    fn from(t: std::time::SystemTime) -> SystemTime {
+        SystemTime(
+            t.duration_since(std::time::UNIX_EPOCH)
+                .unwrap_or(Duration::ZERO),
+        )
+    }
+}
+
+impl std::ops::Add<Duration> for SystemTime {
+    type Output = SystemTime;
+    fn add(self, d: Duration) -> SystemTime {
+        self.checked_add(d)
+            .expect("overflow when adding duration to instant")
+    }
+}
+impl std::ops::Sub<Duration> for SystemTime {
+    type Output = SystemTime;
+    fn sub(self, d: Duration) -> SystemTime {
+        self.checked_sub(d)
+            .expect("overflow when subtracting duration from instant")
+    }
+}
diff --git a/src/chimera/window.rs b/src/chimera/window.rs
new file mode 100644
--- /dev/null
+++ b/src/chimera/window.rs
@@ -0,0 +1,674 @@
+/*
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/.
+ */
+//! The window, in Chimera's build: no SDL, no host window, no host input.
+//!
+//! This keeps the public shape of upstream's `window.rs` so nothing else in
+//! touchHLE has to know. What is underneath differs in three ways:
+//!
+//! - **The screen is a memory buffer** drawn by an OpenGL compiled into the
+//!   core: Mesa's softpipe behind OSMesa, which gives the OpenGL 2.1
+//!   compatibility context touchHLE's GLES1-on-GL2 layer asks for. Every
+//!   context touchHLE makes is an OSMesa context rendering into that one
+//!   buffer, and [Window::swap_window] copies the finished picture out for the
+//!   frontend ([video]).
+//! - **Input is a level, not a stream of events.** The frontend says, once per
+//!   frame, where each finger is and how the device is tilted ([set_touch],
+//!   [set_tilt]); [Window::poll_for_events] turns the difference from what the
+//!   app last heard into touch events, one finger at a time, in finger order.
+//! - **Nothing comes from the host**: no locale, no battery, no URL opening,
+//!   no message boxes. The answers are fixed, because they are part of the
+//!   machine.
+
+use crate::gles::present::present_frame;
+use crate::gles::{create_gles1_ctx_no_parent_stack, GLESContext, GLES};
+use crate::image::Image;
+use crate::matrix::Matrix;
+use crate::options::Options;
+use crate::Environment;
+use std::collections::{HashMap, VecDeque};
+use std::f32::consts::{FRAC_PI_2, PI};
+use std::ffi::{c_char, c_void, CString};
+
+#[allow(non_camel_case_types)]
+#[derive(Copy, Clone, Eq, PartialEq, Debug)]
+pub enum DeviceFamily {
+    iPhone,
+    iPad,
+}
+impl std::fmt::Display for DeviceFamily {
+    fn fmt(&self, f: &mut std::fmt::Formatter) -> std::fmt::Result {
+        std::fmt::Debug::fmt(self, f)
+    }
+}
+impl DeviceFamily {
+    pub fn portrait_size(&self) -> (u32, u32) {
+        match self {
+            DeviceFamily::iPhone => (320, 480),
+            DeviceFamily::iPad => (768, 1024),
+        }
+    }
+}
+impl TryFrom<u64> for DeviceFamily {
+    type Error = ();
+    fn try_from(value: u64) -> Result<Self, Self::Error> {
+        match value {
+            1 => Ok(DeviceFamily::iPhone),
+            2 => Ok(DeviceFamily::iPad),
+            _ => Err(()),
+        }
+    }
+}
+impl TryFrom<&str> for DeviceFamily {
+    type Error = ();
+    fn try_from(value: &str) -> Result<Self, Self::Error> {
+        match value {
+            "iphone" => Ok(DeviceFamily::iPhone),
+            "ipad" => Ok(DeviceFamily::iPad),
+            _ => Err(()),
+        }
+    }
+}
+
+#[derive(Copy, Clone, Eq, PartialEq, Debug)]
+pub enum DeviceOrientation {
+    Portrait,
+    PortraitUpsideDown,
+    LandscapeLeft,
+    LandscapeRight,
+}
+fn size_for_orientation(family: DeviceFamily, orientation: DeviceOrientation) -> (u32, u32) {
+    let (width, height) = family.portrait_size();
+    match orientation {
+        DeviceOrientation::Portrait | DeviceOrientation::PortraitUpsideDown => (width, height),
+        DeviceOrientation::LandscapeLeft | DeviceOrientation::LandscapeRight => (height, width),
+    }
+}
+
+// upstream's whole set, though only touches are made here
+#[allow(dead_code)]
+#[derive(Copy, Clone, PartialEq, Eq, Hash, Debug)]
+pub enum FingerId {
+    Mouse,
+    Touch(i64),
+    VirtualCursor,
+    ButtonToTouch(crate::options::Button),
+    StickToTouch,
+    DpadToTouch,
+}
+pub type Coords = (f32, f32);
+
+#[derive(Debug)]
+#[allow(dead_code)]
+pub enum TextInputEvent {
+    Text(String),
+    Backspace,
+    Return,
+}
+
+#[derive(Debug)]
+#[allow(dead_code)]
+pub enum Event {
+    /// User requested quit.
+    Quit,
+    /// OS has informed touchHLE it will soon become inactive.
+    AppWillResignActive,
+    /// OS has informed touchHLE it will soon terminate.
+    AppWillTerminate,
+    TouchesDown(HashMap<FingerId, Coords>),
+    TouchesMove(HashMap<FingerId, Coords>),
+    TouchesUp(HashMap<FingerId, Coords>),
+    /// User pressed F12, requesting that execution be paused and the debugger
+    /// take over.
+    EnterDebugger,
+    TextInput(TextInputEvent),
+}
+
+#[allow(dead_code)]
+pub enum BatteryState {
+    Unknown,
+    OnBattery,
+    NoBattery,
+    Charging,
+    Full,
+}
+
+pub enum GLVersion {
+    /// OpenGL ES 1.1
+    GLES11,
+    /// OpenGL 2.1 compatibility profile
+    GL21Compat,
+}
+
+// ---- OSMesa -----------------------------------------------------------------
+
+type OSMesaContext = *mut c_void;
+const OSMESA_RGBA: u32 = 0x1908;
+const GL_UNSIGNED_BYTE: u32 = 0x1401;
+const OSMESA_Y_UP: i32 = 0x11;
+extern "C" {
+    fn OSMesaCreateContextExt(
+        format: u32,
+        depth_bits: i32,
+        stencil_bits: i32,
+        accum_bits: i32,
+        sharelist: OSMesaContext,
+    ) -> OSMesaContext;
+    fn OSMesaDestroyContext(ctx: OSMesaContext);
+    fn OSMesaMakeCurrent(
+        ctx: OSMesaContext,
+        buffer: *mut c_void,
+        type_: u32,
+        width: i32,
+        height: i32,
+    ) -> u8;
+    fn OSMesaGetCurrentContext() -> OSMesaContext;
+    fn OSMesaGetProcAddress(name: *const c_char) -> *const c_void;
+    fn OSMesaPixelStore(pname: i32, value: i32);
+}
+
+pub struct GLContext(OSMesaContext);
+
+impl GLContext {
+    pub fn is_current(&self) -> bool {
+        unsafe { OSMesaGetCurrentContext() == self.0 }
+    }
+}
+impl Drop for GLContext {
+    fn drop(&mut self) {
+        unsafe { OSMesaDestroyContext(self.0) }
+    }
+}
+
+fn proc_address(name: &str) -> *const c_void {
+    let name = CString::new(name).unwrap();
+    unsafe { OSMesaGetProcAddress(name.as_ptr()) }
+}
+
+// ---- What the frontend sees and says ------------------------------------------
+
+/// Fingers the frontend can hold down at once.
+pub const MAX_FINGERS: usize = 2;
+
+#[derive(Copy, Clone, PartialEq, Debug, Default)]
+struct Finger {
+    down: bool,
+    /// Where it is on the picture as shown, in that picture's pixels.
+    x: f32,
+    y: f32,
+}
+
+struct Shared {
+    /// The last picture swapped to the screen, top row first, BGRA.
+    video: Vec<u8>,
+    video_width: u32,
+    video_height: u32,
+    /// This frame's input, as the frontend set it.
+    fingers: [Finger; MAX_FINGERS],
+    /// Tilt, -1.0..=1.0 on each axis: what an analog stick does upstream.
+    tilt: (f32, f32),
+}
+static mut SHARED: Shared = Shared {
+    video: Vec::new(),
+    video_width: 0,
+    video_height: 0,
+    fingers: [Finger {
+        down: false,
+        x: 0.0,
+        y: 0.0,
+    }; MAX_FINGERS],
+    tilt: (0.0, 0.0),
+};
+// The machine is one thread.
+#[allow(static_mut_refs)]
+fn shared() -> &'static mut Shared {
+    unsafe { &mut SHARED }
+}
+
+/// The last picture the app put on the screen: BGRA, top row first, and its
+/// size. Empty until the first one.
+pub fn video() -> (&'static [u8], u32, u32) {
+    let s = shared();
+    (&s.video, s.video_width, s.video_height)
+}
+
+/// Where finger `index` is this frame, in pixels of the picture as [video]
+/// shows it; `None` if it is not touching the screen.
+pub fn set_touch(index: usize, at: Option<(f32, f32)>) {
+    let finger = &mut shared().fingers[index];
+    *finger = match at {
+        Some((x, y)) => Finger { down: true, x, y },
+        None => Finger {
+            down: false,
+            ..*finger
+        },
+    };
+}
+
+/// How the device is tilted this frame, each axis -1.0..=1.0.
+pub fn set_tilt(x: f32, y: f32) {
+    shared().tilt = (x.clamp(-1.0, 1.0), y.clamp(-1.0, 1.0));
+}
+
+// ---- The window ---------------------------------------------------------------
+
+pub struct Window {
+    /// The screen OSMesa draws into: RGBA, top row first, sized for the
+    /// largest orientation so it never moves.
+    screen: Box<[u8]>,
+    event_queue: VecDeque<Event>,
+    internal_gl_ins: Option<Box<dyn GLESContext>>,
+    splash_image: Option<Image>,
+    device_family: DeviceFamily,
+    device_orientation: DeviceOrientation,
+    share_with_current: bool,
+    screen_saver_enabled: bool,
+    /// What the app has been told about each finger.
+    fingers_heard: [Finger; MAX_FINGERS],
+    /// Whether or not we are on the "main" environment stack (rather than
+    /// a coroutine stack). Kept for upstream's assertions.
+    pub(super) on_main_stack: bool,
+}
+
+impl Window {
+    pub fn rotatable_fullscreen() -> bool {
+        false
+    }
+    pub fn new(
+        _title: &str,
+        _icon: Option<Image>,
+        launch_image: Option<Image>,
+        options: &Options,
+    ) -> Window {
+        let device_family = options.device_family.unwrap_or(DeviceFamily::iPhone);
+        let (w, h) = device_family.portrait_size();
+        let mut window = Window {
+            screen: vec![0u8; (w * h * 4) as usize].into_boxed_slice(),
+            event_queue: VecDeque::new(),
+            internal_gl_ins: None,
+            splash_image: launch_image,
+            device_family,
+            device_orientation: options.initial_orientation,
+            share_with_current: false,
+            screen_saver_enabled: true,
+            fingers_heard: [Finger::default(); MAX_FINGERS],
+            on_main_stack: true,
+        };
+
+        // The OpenGL ES context for the splash screen and app UI rendering
+        // (see src/frameworks/core_animation/composition.rs).
+        let mut gl_ins = create_gles1_ctx_no_parent_stack(&mut window, options);
+        {
+            let gl_ctx = gl_ins.make_current(&mut window);
+            log!("Driver info: {}", unsafe { gl_ctx.driver_description() });
+        }
+        window.internal_gl_ins = Some(gl_ins);
+
+        if window.splash_image.is_some() {
+            window.display_splash();
+        }
+
+        window
+    }
+
+    /// Turn this frame's input into the events the app has not heard yet:
+    /// one event per finger that went down, moved or came up, in finger
+    /// order.
+    pub fn poll_for_events(&mut self, _options: &Options) {
+        let fingers = shared().fingers;
+        for (index, (now, heard)) in fingers
+            .iter()
+            .zip(self.fingers_heard.iter_mut())
+            .enumerate()
+        {
+            let id = FingerId::Touch(index as i64);
+            let event = match (heard.down, now.down) {
+                (false, true) => Some(Event::TouchesDown(HashMap::from([(
+                    id,
+                    transform_input_coords(self.device_family, self.device_orientation, now),
+                )]))),
+                (true, true) if (now.x, now.y) != (heard.x, heard.y) => {
+                    Some(Event::TouchesMove(HashMap::from([(
+                        id,
+                        transform_input_coords(self.device_family, self.device_orientation, now),
+                    )])))
+                }
+                (true, false) => Some(Event::TouchesUp(HashMap::from([(
+                    id,
+                    transform_input_coords(self.device_family, self.device_orientation, heard),
+                )]))),
+                _ => None,
+            };
+            if let Some(event) = event {
+                self.event_queue.push_back(event);
+                *heard = *now;
+            }
+        }
+    }
+
+    /// Pop an event from the queue (in FIFO order)
+    pub fn pop_event(&mut self) -> Option<Event> {
+        self.event_queue.pop_front()
+    }
+
+    pub fn print_accelerometer_notice(&self, _options: &Options) {
+        log!("This app uses the accelerometer: Tilt X and Tilt Y tilt the device.");
+    }
+
+    /// The simulated accelerometer: upstream's analog-stick tilt simulation,
+    /// driven by this frame's tilt.
+    pub fn get_acceleration(&self, options: &Options) -> (f32, f32, f32) {
+        let (x, y) = shared().tilt;
+
+        // Correct for window rotation
+        let [x, y] = self.rotation_matrix().inverse().unwrap().transform([x, y]);
+        let (x, y) = (x.clamp(-1.0, 1.0), y.clamp(-1.0, 1.0)); // just in case
+
+        // Lying flat on its back, the device reports (0, 0, -1); the stick
+        // tilts it about the x and y axes (see upstream's window.rs).
+        let gravity: [f32; 3] = [0.0, 0.0, -1.0];
+        let neutral_x = options.x_tilt_offset.to_radians();
+        let neutral_y = options.y_tilt_offset.to_radians();
+        let x_rotation_range = options.x_tilt_range.to_radians() / 2.0;
+        let y_rotation_range = options.y_tilt_range.to_radians() / 2.0;
+        let x_rotation = neutral_x - x_rotation_range * y;
+        let y_rotation = neutral_y - y_rotation_range * x;
+        let matrix =
+            Matrix::<3>::y_rotation(y_rotation).multiply(&Matrix::<3>::x_rotation(x_rotation));
+        let [x, y, z] = matrix.transform(gravity);
+        (x, y, z)
+    }
+
+    pub fn virtual_cursor_visible_at(&self) -> Option<(f32, f32, bool)> {
+        None
+    }
+
+    pub fn create_gl_context(&self, version: GLVersion) -> Result<GLContext, String> {
+        match version {
+            GLVersion::GLES11 => Err("this build's OpenGL is desktop OpenGL only".to_string()),
+            GLVersion::GL21Compat => {
+                let share = if self.share_with_current {
+                    unsafe { OSMesaGetCurrentContext() }
+                } else {
+                    std::ptr::null_mut()
+                };
+                let ctx = unsafe { OSMesaCreateContextExt(OSMESA_RGBA, 24, 8, 0, share) };
+                if ctx.is_null() {
+                    Err("OSMesaCreateContextExt failed".to_string())
+                } else {
+                    Ok(GLContext(ctx))
+                }
+            }
+        }
+    }
+
+    pub fn gl_get_proc_address(&self, procname: &str) -> *const std::ffi::c_void {
+        proc_address(procname)
+    }
+
+    pub fn set_share_with_current_context(&mut self, value: bool) {
+        self.share_with_current = value;
+    }
+
+    fn make_current_raw(&mut self, gl_ctx: &GLContext) {
+        let (w, h) = size_for_orientation(self.device_family, self.device_orientation);
+        unsafe {
+            let ok = OSMesaMakeCurrent(
+                gl_ctx.0,
+                self.screen.as_mut_ptr() as *mut c_void,
+                GL_UNSIGNED_BYTE,
+                w as i32,
+                h as i32,
+            );
+            assert!(ok != 0, "OSMesaMakeCurrent failed");
+            // the first row of the buffer is the top of the screen
+            OSMesaPixelStore(OSMESA_Y_UP, 0);
+        }
+    }
+
+    /// # Safety
+    /// As upstream: the context must outlive its use.
+    pub unsafe fn make_gl_context_current(&mut self, gl_ctx: &GLContext) {
+        self.make_current_raw(gl_ctx);
+    }
+
+    /// Make the internal OpenGL ES context (for splash screen and UI rendering)
+    /// current.
+    #[must_use]
+    pub fn make_internal_gl_ctx_current<'win>(&'win mut self) -> Box<dyn GLES + 'win> {
+        let (w, h) = size_for_orientation(self.device_family, self.device_orientation);
+        let screen = self.screen.as_mut_ptr();
+        unsafe {
+            self.internal_gl_ins
+                .as_mut()
+                .unwrap()
+                .make_current_unchecked_for_window(
+                    &mut |gl_ctx| {
+                        let ok = OSMesaMakeCurrent(
+                            gl_ctx.0,
+                            screen as *mut c_void,
+                            GL_UNSIGNED_BYTE,
+                            w as i32,
+                            h as i32,
+                        );
+                        assert!(ok != 0, "OSMesaMakeCurrent failed");
+                        OSMesaPixelStore(OSMESA_Y_UP, 0);
+                    },
+                    &mut |s| proc_address(s),
+                )
+        }
+    }
+
+    fn display_splash(&mut self) {
+        assert!(self.splash_image.is_some());
+
+        // OpenGL ES expects bottom-to-top row order for image data, but our
+        // image data will be top-to-bottom. A reflection transform compensates.
+        let matrix = self.rotation_matrix().multiply(&Matrix::y_flip());
+        let viewport = self.viewport();
+
+        let image = self.splash_image.take().unwrap();
+        unsafe {
+            let mut gl_ctx = self.make_internal_gl_ctx_current();
+
+            use crate::gles::gles11_raw as gles11; // constants only
+
+            let mut texture = 0;
+            gl_ctx.GenTextures(1, &mut texture);
+            gl_ctx.BindTexture(gles11::TEXTURE_2D, texture);
+            let (width, height) = image.dimensions();
+            gl_ctx.TexImage2D(
+                gles11::TEXTURE_2D,
+                0,
+                gles11::RGBA as _,
+                width as _,
+                height as _,
+                0,
+                gles11::RGBA,
+                gles11::UNSIGNED_BYTE,
+                image.pixels().as_ptr() as *const _,
+            );
+            gl_ctx.TexParameteri(
+                gles11::TEXTURE_2D,
+                gles11::TEXTURE_MIN_FILTER,
+                gles11::LINEAR as _,
+            );
+            gl_ctx.TexParameteri(
+                gles11::TEXTURE_2D,
+                gles11::TEXTURE_MAG_FILTER,
+                gles11::LINEAR as _,
+            );
+
+            present_frame(gl_ctx.as_mut(), viewport, matrix, None);
+
+            gl_ctx.DeleteTextures(1, &texture);
+        };
+        self.splash_image = Some(image);
+
+        self.swap_window();
+    }
+
+    /// Present what was drawn: wait for OpenGL to finish it, then copy the
+    /// screen out for the frontend.
+    pub fn swap_window(&self) {
+        let finish = proc_address("glFinish");
+        assert!(!finish.is_null());
+        // OSMesa copies the picture into the screen buffer on glFinish.
+        unsafe { std::mem::transmute::<*const c_void, extern "C" fn()>(finish)() };
+
+        let (w, h) = size_for_orientation(self.device_family, self.device_orientation);
+        let s = shared();
+        let len = (w * h * 4) as usize;
+        s.video.resize(len, 0);
+        for (dst, src) in s
+            .video
+            .chunks_exact_mut(4)
+            .zip(self.screen[..len].chunks_exact(4))
+        {
+            dst[0] = src[2];
+            dst[1] = src[1];
+            dst[2] = src[0];
+            dst[3] = 0xff;
+        }
+        s.video_width = w;
+        s.video_height = h;
+    }
+
+    /// Consider the emulated device to be rotated to a particular orientation:
+    /// the picture changes shape.
+    pub fn rotate_device(&mut self, new_orientation: DeviceOrientation) {
+        if new_orientation == self.device_orientation {
+            return;
+        }
+        self.device_orientation = new_orientation;
+        // The screen changes shape, and OSMesa only learns a buffer's size
+        // when a context is bound to it - which touchHLE skips for a context
+        // that is already current. So the current one is bound again now, or
+        // it keeps drawing rows of the old width into a buffer read with the
+        // new one (Castle of Magic turns itself sideways at its first frame).
+        let current = unsafe { OSMesaGetCurrentContext() };
+        if !current.is_null() {
+            let (w, h) = size_for_orientation(self.device_family, self.device_orientation);
+            unsafe {
+                let ok = OSMesaMakeCurrent(
+                    current,
+                    self.screen.as_mut_ptr() as *mut c_void,
+                    GL_UNSIGNED_BYTE,
+                    w as i32,
+                    h as i32,
+                );
+                assert!(ok != 0, "OSMesaMakeCurrent failed");
+                OSMesaPixelStore(OSMESA_Y_UP, 0);
+            }
+        }
+        if self.splash_image.is_some() {
+            self.display_splash();
+        }
+    }
+
+    pub fn device_family(&self) -> DeviceFamily {
+        self.device_family
+    }
+
+    /// Returns the current device orientation
+    pub fn current_rotation(&self) -> DeviceOrientation {
+        self.device_orientation
+    }
+
+    /// Get the size in pixels of the window without rotation or scaling.
+    #[allow(dead_code)]
+    pub fn size_unrotated_unscaled(&self) -> (u32, u32) {
+        self.device_family.portrait_size()
+    }
+
+    /// The region of the screen (x, y, width, height) used to display the app
+    /// content: all of it.
+    pub fn viewport(&self) -> (u32, u32, u32, u32) {
+        let (w, h) = size_for_orientation(self.device_family, self.device_orientation);
+        (0, 0, w, h)
+    }
+
+    #[allow(dead_code)]
+    pub fn viewport_y_offset(&self) -> u32 {
+        0
+    }
+
+    /// Transformation matrix between the window's co-ordinate space and the
+    /// app's when rotation is in use (see upstream's window.rs).
+    pub fn rotation_matrix(&self) -> Matrix<2> {
+        rotation_matrix(self.device_orientation)
+    }
+
+    pub fn is_screen_saver_enabled(&self) -> bool {
+        self.screen_saver_enabled
+    }
+    pub fn set_screen_saver_enabled(&mut self, enabled: bool) {
+        self.screen_saver_enabled = enabled;
+    }
+
+    pub fn start_text_input(&self) {}
+    pub fn stop_text_input(&self) {}
+
+    pub fn on_main_stack(&self) -> bool {
+        self.on_main_stack
+    }
+}
+
+fn rotation_matrix(orientation: DeviceOrientation) -> Matrix<2> {
+    match orientation {
+        DeviceOrientation::Portrait => Matrix::identity(),
+        DeviceOrientation::PortraitUpsideDown => Matrix::z_rotation(PI),
+        DeviceOrientation::LandscapeLeft => Matrix::z_rotation(-FRAC_PI_2),
+        DeviceOrientation::LandscapeRight => Matrix::z_rotation(FRAC_PI_2),
+    }
+}
+
+/// A point on the picture as shown to where the app thinks it was touched
+/// (upstream's transform_input_coords, with the whole picture as viewport).
+fn transform_input_coords(
+    family: DeviceFamily,
+    orientation: DeviceOrientation,
+    finger: &Finger,
+) -> Coords {
+    let (vw, vh) = size_for_orientation(family, orientation);
+    // normalize to unit square centred on origin
+    let x = finger.x / vw as f32 - 0.5;
+    let y = finger.y / vh as f32 - 0.5;
+    // rotate
+    let matrix = rotation_matrix(orientation).inverse().unwrap();
+    let [x, y] = matrix.transform([x, y]);
+    // back to pixels
+    let (out_w, out_h) = family.portrait_size();
+    let out_x = (x + 0.5) * out_w as f32;
+    let out_y = (y + 0.5) * out_h as f32;
+    // Round to match touch precision of official devices.
+    (out_x.round(), out_y.round())
+}
+
+pub fn open_url(_env: &mut Environment, url: &str) -> Result<(), String> {
+    Err(format!("this machine cannot open {url}"))
+}
+
+/// Upstream shows a message box; here the error is all there is to say.
+pub fn show_error_messagebox(_window: Option<&Window>, error_message: &str) {
+    echo!(
+        "touchHLE crashed with the following error: {}",
+        error_message
+    );
+}
+
+/// A fixed answer: the battery is part of the machine.
+pub fn get_battery_status() -> (i32, BatteryState) {
+    (100, BatteryState::Full)
+}
+
+/// A fixed answer: the locale is part of the machine.
+pub fn get_preferred_language_codes(_env: &mut Environment) -> Vec<String> {
+    vec!["en".to_string()]
+}
+
+pub fn get_preferred_country_codes(_env: &mut Environment) -> Vec<String> {
+    vec!["US".to_string()]
+}
