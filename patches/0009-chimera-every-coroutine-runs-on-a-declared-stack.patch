+type Machine = Coroutine<(), (), Result<(), String>, GuestStack>;
+
+/// A coroutine stack that the sandbox knows is a stack.
+///
+/// corosensei's own stack is reserved PROT_NONE and then made writable, so to
+/// miniBox it is ordinary memory, and a clean page of ordinary memory is
+/// write-protected until its first write (that is how a savestate knows what
+/// changed). Windows delivers an exception by pushing it onto the faulting
+/// thread's own stack, so the first time anything faulted while the stack
+/// pointer was on such a page, the push failed too and the process died with
+/// no handler run. Memory mapped writable with MAP_STACK is a stack to
+/// miniBox and is never write-protected; the guard page is made after.
+pub struct GuestStack {
+    base: StackPointer,
+    len: usize,
+}
+
+const PAGE_SIZE: usize = 4096;
+
+impl GuestStack {
+    pub fn new(size: usize) -> std::io::Result<Self> {
+        // the guard page below the size asked for, rounded up to pages
+        let len = (size.max(MIN_STACK_SIZE) + 2 * PAGE_SIZE - 1) & !(PAGE_SIZE - 1);
+        unsafe {
+            let p = libc::mmap(
+                std::ptr::null_mut(),
+                len,
+                libc::PROT_READ | libc::PROT_WRITE,
+                libc::MAP_PRIVATE | libc::MAP_ANONYMOUS | libc::MAP_STACK,
+                -1,
+                0,
+            );
+            if p == libc::MAP_FAILED {
+                return Err(std::io::Error::last_os_error());
+            }
+            // made first, so a failure below unmaps it
+            let out = GuestStack {
+                base: StackPointer::new(p as usize + len).unwrap(),
+                len,
+            };
+            if libc::mprotect(p, PAGE_SIZE, libc::PROT_NONE) != 0 {
+                return Err(std::io::Error::last_os_error());
+            }
+            Ok(out)
+        }
+    }
+}
+
+/// The size corosensei's DefaultStack gives a coroutine.
+impl Default for GuestStack {
+    fn default() -> Self {
+        GuestStack::new(1 << 20).expect("no stack for a coroutine")
+    }
+}
+
+impl Drop for GuestStack {
+    fn drop(&mut self) {
+        unsafe {
+            libc::munmap((self.base.get() - self.len) as *mut libc::c_void, self.len);
+        }
+    }
+}
+
+unsafe impl Stack for GuestStack {
+    fn base(&self) -> StackPointer {
+        self.base
+    }
+
+    fn limit(&self) -> StackPointer {
+        StackPointer::new(self.base.get() - self.len).unwrap()
+    }
+}
 
