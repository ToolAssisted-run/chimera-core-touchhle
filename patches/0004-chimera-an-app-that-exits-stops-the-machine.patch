+/// The app exited (`exit()`, or UIKit's termination): upstream ends the
+/// process; here the machine stops where it stands, its last picture kept,
+/// and the core is told so. It is never resumed. Called from wherever the app
+/// exits, which is usually a guest thread's stack: the jump back to the core
+/// is made from the machine's own stack, as every frame's is.
+pub(crate) fn exit_machine(env: &mut Environment, code: i32) -> ! {
+    let s = state();
+    s.exited = Some(match code {
+        0 => Ok(()),
+        _ => Err(format!("the app exited with status {code}")),
+    });
+    s.frame += 1;
+    if env.window.is_none() {
+        // headless (no frames to stop at): as upstream
+        std::process::exit(code);
+    }
+    env.on_parent_stack_in_coroutine(|_, _| unsafe { (*state().yielder).suspend(()) });
+    unreachable!("a machine whose app exited was resumed");
+}
+
 fn end_frame(env: &mut Environment) {
