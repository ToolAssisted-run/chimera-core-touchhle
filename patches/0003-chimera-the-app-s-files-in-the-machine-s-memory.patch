+
+/// The bytes of a [FileLocation::Memory] file, shared by every handle open on
+/// it, and when they last changed (seconds since the Unix epoch).
+#[derive(Debug, Default)]
+pub struct MemFileData {
+    bytes: Vec<u8>,
+    modified: i64,
+}
+pub type MemFile = Rc<RefCell<MemFileData>>;
+
+#[cfg_attr(not(feature = "chimera"), allow(dead_code))]
+fn new_mem_file() -> MemFile {
+    let file = MemFile::default();
+    touch_mem_file(&file);
+    file
+}
+fn touch_mem_file(file: &MemFile) {
+    file.borrow_mut().modified = crate::time::SystemTime::now()
+        .duration_since(crate::time::UNIX_EPOCH)
+        .map(|d| d.as_secs() as i64)
+        .unwrap_or(0);
+}
