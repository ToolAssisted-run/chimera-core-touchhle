+/// Chimera's build has no audio device: every device the app (or touchHLE
+/// itself) opens is an OpenAL Soft LOOPBACK device, which plays nothing by
+/// itself, and at the end of each frame the core asks every one of them for
+/// that frame's samples and mixes them ([render_frame]). OpenAL Soft's own
+/// output backends are not even built (its null backend mixes on a thread
+/// that sleeps on the host's clock).
+#[cfg(feature = "chimera")]
+pub mod loopback {
+    use super::al_sys;
+    use super::alc_types::{ALCchar, ALCdevice, ALCint, ALCsizei};
+
+    /// What every loopback device renders: 44.1 kHz, stereo, 16-bit.
+    pub const RATE: ALCint = 44100;
+    const ALC_FREQUENCY: ALCint = 0x1007;
+    const ALC_FORMAT_CHANNELS_SOFT: ALCint = 0x1990;
+    const ALC_FORMAT_TYPE_SOFT: ALCint = 0x1991;
+    const ALC_STEREO_SOFT: ALCint = 0x1501;
+    const ALC_SHORT_SOFT: ALCint = 0x1402;
+
+    extern "C" {
+        fn alcLoopbackOpenDeviceSOFT(device_name: *const ALCchar) -> *mut ALCdevice;
+        fn alcRenderSamplesSOFT(
+            device: *mut ALCdevice,
+            buffer: *mut std::ffi::c_void,
+            samples: ALCsizei,
+        );
+    }
+
+    // The machine is one thread; the devices in the order they were opened.
+    static mut DEVICES: Vec<*mut ALCdevice> = Vec::new();
+    #[allow(static_mut_refs)]
+    fn devices() -> &'static mut Vec<*mut ALCdevice> {
+        unsafe { &mut DEVICES }
+    }
+
+    /// # Safety
+    /// As OpenAL's alcOpenDevice; the name is ignored.
+    pub unsafe fn alcOpenDevice(_device_name: *const ALCchar) -> *mut ALCdevice {
+        let device = unsafe { alcLoopbackOpenDeviceSOFT(std::ptr::null()) };
+        if !device.is_null() {
+            devices().push(device);
+        }
+        device
+    }
+
+    /// # Safety
+    /// As OpenAL's alcCloseDevice.
+    pub unsafe fn alcCloseDevice(device: *mut ALCdevice) -> super::alc_types::ALCboolean {
+        devices().retain(|d| *d != device);
+        unsafe { al_sys::alcCloseDevice(device) }
+    }
+
+    /// A context's attributes, with the loopback format the device renders
+    /// in put in place of any the app asked for.
+    ///
+    /// # Safety
+    /// `attrlist` is null or a zero-terminated attribute list.
+    pub unsafe fn attributes(attrlist: *const ALCint) -> Vec<ALCint> {
+        let mut out = Vec::new();
+        if !attrlist.is_null() {
+            let mut p = attrlist;
+            while unsafe { *p } != 0 {
+                let (key, value) = unsafe { (*p, *p.add(1)) };
+                if ![
+                    ALC_FREQUENCY,
+                    ALC_FORMAT_CHANNELS_SOFT,
+                    ALC_FORMAT_TYPE_SOFT,
+                ]
+                .contains(&key)
+                {
+                    out.extend([key, value]);
+                }
+                p = unsafe { p.add(2) };
+            }
+        }
+        out.extend([
+            ALC_FREQUENCY,
+            RATE,
+            ALC_FORMAT_CHANNELS_SOFT,
+            ALC_STEREO_SOFT,
+            ALC_FORMAT_TYPE_SOFT,
+            ALC_SHORT_SOFT,
+            0,
+        ]);
+        out
+    }
+
+    /// Render `out.len() / 2` stereo sample pairs from every open device and
+    /// mix them into `out`.
+    pub fn render_frame(out: &mut [i16]) {
+        out.fill(0);
+        let pairs = out.len() / 2;
+        let mut scratch = vec![0i16; pairs * 2];
+        for &device in devices().iter() {
+            unsafe {
+                alcRenderSamplesSOFT(device, scratch.as_mut_ptr() as *mut _, pairs as ALCsizei)
+            };
+            for (o, s) in out.iter_mut().zip(&scratch) {
+                *o = o.saturating_add(*s);
+            }
+        }
+    }
+}
 
