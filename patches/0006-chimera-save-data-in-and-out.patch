+/// Save data for the app, before the machine starts: (path under the app's
+/// home directory, bytes), e.g. ("Documents/save.dat", ...). Only paths under
+/// Documents/ and Library/ are taken.
+pub fn set_save_data(files: Vec<(String, Vec<u8>)>) -> Result<(), String> {
+    for (path, _) in &files {
+        let ok = (path.starts_with("Documents/") || path.starts_with("Library/"))
+            && !path
+                .split('/')
+                .any(|c| c.is_empty() || c == "." || c == "..");
+        if !ok {
+            return Err(format!(
+                "{path:?} is not a file under the app's Documents or Library folder"
+            ));
+        }
+    }
+    state().save_data = files;
+    Ok(())
+}
+
+pub(crate) fn take_save_data() -> Vec<(String, Vec<u8>)> {
+    std::mem::take(&mut state().save_data)
+}
+
+/// What the app has saved, between frames: every file under its Documents
+/// and Library folders (Library/Caches left out: a cache is not a save), as
+/// (path under the home directory, bytes), in name order. Empty before the
+/// first frame.
+pub fn save_data() -> Vec<(String, Vec<u8>)> {
+    let env = state().stopped;
+    if env.is_null() {
+        return Vec::new();
+    }
+    let env = unsafe { &mut *env };
+    let home = env.fs.home_directory().to_owned();
+    let mut out = Vec::new();
+    for top in ["Documents", "Library"] {
+        let base = home.join(top);
+        let Ok(paths) = env.fs.enumerate_recursive(&base) else {
+            continue;
+        };
+        for path in paths {
+            let rel = format!("{top}/{}", path.as_str());
+            if rel == "Library/Caches" || rel.starts_with("Library/Caches/") {
+                continue;
+            }
+            let full = base.join(path.as_str());
+            if env.fs.is_file(&full) {
+                if let Ok(bytes) = env.fs.read(&full) {
+                    out.push((rel, bytes));
+                }
+            }
+        }
+    }
+    out.sort_by(|a, b| a.0.cmp(&b.0));
+    out
+}
