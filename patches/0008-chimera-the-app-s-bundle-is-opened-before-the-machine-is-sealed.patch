+    let open = || {
+        crate::fs::BundleData::open_any(std::path::Path::new(path))
+            .map_err(|e| format!("Could not open app bundle: {e}"))
+    };
+    crate::bundle::Bundle::new_bundle_and_fs_from_host_path(
+        open()?,
