+/// Chimera's build: the one block of guest memory, made the first time it is
+/// asked for and never given back. The core asks before the machine starts,
+/// so it can tell the frontend where the app's memory is (a memory domain is
+/// published once, right after the core loads); Mem::new then takes it.
+#[cfg(feature = "chimera")]
+pub fn chimera_block() -> *mut u8 {
+    static mut BLOCK: *mut u8 = std::ptr::null_mut();
+    unsafe {
+        if BLOCK.is_null() {
+            BLOCK =
+                crate::mem::host::allocate_memory(std::mem::size_of::<Bytes>()).unwrap() as *mut u8;
+        }
+        BLOCK
+    }
+}
