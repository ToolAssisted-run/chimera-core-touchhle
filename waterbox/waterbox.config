{
  "coreName": "touchHLE",
  "systemId": "iOS",
  "systemNames": { "iOS": "iPhone OS" },
  "author": "The touchHLE project contributors; chimera port by Sergio Martin",
  "url": "https://github.com/ToolAssisted-run/chimera-core-touchhle",
  "romFile": "game",
  "deterministic": true,
  "memoryLayoutMiB": [256, 16, 16, 256, 6144],
  "_memoryLayoutMiB_note": "sbrk, sealed, invisible, plain, mmap. touchHLE gives the app the whole 32-bit address space an iPhone has, 4 GiB mapped at once (only the pages the app touches cost anything); the JIT's code cache, the coroutine stacks the app's threads run on, the software OpenGL's buffers and the app's own files - its Documents and Library live in this memory, so a savestate carries them - share the mmap heap with it.",
  "video": {
    "_comment": "The iPhone's screen as the app draws it: 320x480 held upright, 480x320 when the app turns it sideways (an iPad app gets 768x1024 or 1024x768). Drawn by Mesa's softpipe inside the core, so the picture is the same on every machine.",
    "width": 1024,
    "height": 1024,
    "virtualWidth": 320,
    "virtualHeight": 480,
    "vsyncNumerator": 60,
    "vsyncDenominator": 1
  },
  "audio": {
    "_comment": "OpenAL's mix of every source the app plays, rendered at the end of each frame: 44.1 kHz stereo, exactly 735 pairs a frame.",
    "rate": 44100,
    "samplesPerFrame": 735,
    "channels": 2,
    "get": "GetAudio"
  },
  "extensions": {
    ".ipa": "iOS"
  },
  "input": {
    "name": "iPhone",
    "_comment": "Two fingers and the accelerometer. Touch 1 and Touch 2 hold a finger on the screen, at Touch 1 X/Y and Touch 2 X/Y: 0..65535 across and down the picture as it is shown, as every absolute position in Chimera is, so a sideways app is touched where it is seen. Moving a held finger is a drag. Tilt X and Tilt Y tilt the device the way an analog stick does in touchHLE (-32768..32767; at rest it lies flat on its back).",
    "buttons": ["Touch 1", "Touch 2"],
    "mnemonics": { "Touch 1": "1", "Touch 2": "2" },
    "axes": [
      { "name": "Touch 1 X", "min": 0, "max": 65535, "neutral": 32768, "header": "T1X" },
      { "name": "Touch 1 Y", "min": 0, "max": 65535, "neutral": 32768, "header": "T1Y" },
      { "name": "Touch 2 X", "min": 0, "max": 65535, "neutral": 32768, "header": "T2X" },
      { "name": "Touch 2 Y", "min": 0, "max": 65535, "neutral": 32768, "header": "T2Y" },
      { "name": "Tilt X", "min": -32768, "max": 32767, "neutral": 0, "header": "TX" },
      { "name": "Tilt Y", "min": -32768, "max": 32767, "neutral": 0, "header": "TY" }
    ]
  },
  "settings": [
    {
      "name": "device_family",
      "display": "Device",
      "type": "enum",
      "options": ["auto", "iphone", "ipad"],
      "default": "auto",
      "description": "Which device the app runs on. Auto uses the app's own choice, which is the iPhone unless the app is for the iPad only. An app made for both runs on the device chosen here. It is part of the machine, so a movie needs the same device."
    },
    {
      "name": "orientation",
      "display": "Starting Orientation",
      "type": "enum",
      "options": ["app", "portrait", "upside-down", "landscape-left", "landscape-right"],
      "default": "app",
      "description": "How the device is held when the app starts. 'App' lets touchHLE decide. It knows which way many games are held and starts them that way, and an app can also turn the device itself. It is part of the machine."
    },
    {
      "name": "rtc_start",
      "display": "Clock at Power-On",
      "type": "int",
      "default": 1262304000,
      "min": 978307200,
      "max": 2145916800,
      "description": "The date the device's clock shows when the app starts, in seconds since 1970. For example 1262304000 is 2010-01-01, in the years these apps were made. It cannot be earlier than 2001-01-01, which is the date Apple's clocks count from. After the start the clock runs with the emulated device and never with your computer. It is part of the machine. A game that picks its random numbers from the time plays differently with another date."
    },
    {
      "name": "cpu_mhz",
      "display": "CPU Clock (MHz)",
      "type": "int",
      "default": 412,
      "min": 100,
      "max": 2000,
      "description": "How fast the device's ARM processor runs. The app's own code uses up emulated time at this speed. The first iPhone and the iPhone 3G ran at 412 MHz, the 3GS and the third iPod touch at 600 MHz, and the iPad at 1000 MHz. The system functions that touchHLE provides itself take no emulated time. It is part of the machine."
    }
  ]
}
